APP_NAME="LMS Codar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cursosdecodar.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs enxutos: só erros e no máximo 3 dias
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=3

# ===== BANCO Hostinger (cursosdecodar.com.br) =====
# Os valores reais ficam em .env / .env.production (não versionar)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u137675042_cursodecodar
DB_USERNAME=u137675042_eliasgomesjf
DB_PASSWORD=coloque_a_senha_aqui

# Sessão/cache em arquivo = menos tabelas e menos crescimento no banco
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@SEU-DOMINIO.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
